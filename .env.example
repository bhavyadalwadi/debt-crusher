# Local development default: SQLite in prisma/dev.db
# For Vercel production, set DATABASE_URL to your Neon Postgres connection string.
DATABASE_URL="file:./dev.db"

# Required site-wide gate for both local and Vercel.
PRIVATE_ACCESS_USERNAME="change-me"
PRIVATE_ACCESS_PASSWORD="change-me-too"
SESSION_SECRET="replace-with-a-long-random-secret"
