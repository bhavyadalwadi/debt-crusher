# Local development should use a local/dev Neon Postgres database.
# Vercel production should use a separate prod Neon Postgres database.
DATABASE_URL="postgres://USER:PASSWORD@HOST:5432/debt_crusher?sslmode=require"

# Required site-wide gate for both local and Vercel.
BASIC_AUTH_USERNAME="change-me"
BASIC_AUTH_PASSWORD="change-me-too"
