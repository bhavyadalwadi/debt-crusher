# Local development default: SQLite in prisma/dev.db
# For Vercel production, set DATABASE_URL to your Neon Postgres connection string.
DATABASE_URL="file:./dev.db"

# Clerk development instance. Production keys must never be placed in Preview.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY="pk_test_replace-me"
CLERK_SECRET_KEY="sk_test_replace-me"
NEXT_PUBLIC_CLERK_FRONTEND_API_URL="https://your-instance.clerk.accounts.dev"
NEXT_PUBLIC_CLERK_SIGN_IN_URL="/sign-in"
DEBT_CRUSHER_OWNER_CLERK_USER_ID="user_replace-me"

# Plaid is deliberately sandbox-only. The application refuses production.
PLAID_ENV="sandbox"
PLAID_CLIENT_ID="replace-me"
PLAID_SECRET="replace-me"
PLAID_WEBHOOK_URL="https://your-staging-host.example/api/plaid/webhook"

# Generate these independently. The KEK is 32 random bytes encoded as base64;
# SECURITY_HASH_KEY is a different 32 random bytes encoded as hex.
# See SECRET_KEY_MANAGEMENT.md. Never reuse one value for both purposes.
FINANCIAL_TOKEN_KEY_VERSION="v1"
FINANCIAL_TOKEN_KEK_V1="replace-with-32-byte-base64-key"
SECURITY_HASH_KEY="replace-with-a-separate-long-random-secret"
