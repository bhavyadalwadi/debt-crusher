{
  "name": "debt-crusher",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "predev": "prisma generate",
    "dev": "next dev",
    "build": "prisma generate --schema prisma/schema.postgres.prisma && next build",
    "prestart": "prisma generate --schema prisma/schema.postgres.prisma",
    "start": "next start",
    "test": "vitest run",
    "postinstall": "prisma generate",
    "prisma:generate": "prisma generate",
    "prisma:generate:postgres": "prisma generate --schema prisma/schema.postgres.prisma",
    "db:push": "prisma db push",
    "db:push:postgres": "prisma db push --schema prisma/schema.postgres.prisma",
    "db:migrate": "prisma migrate deploy",
    "db:backfill:operations": "node scripts/backfill-operations.mjs",
    "db:verify:operations": "node scripts/verify-operations.mjs",
    "security:rotate-token-key": "node scripts/rotate-financial-token-key.mjs",
    "db:backfill:operations:postgres": "prisma generate --schema prisma/schema.postgres.prisma && node scripts/backfill-operations.mjs",
    "db:verify:operations:postgres": "prisma generate --schema prisma/schema.postgres.prisma && node scripts/verify-operations.mjs"
  },
  "dependencies": {
    "@clerk/nextjs": "^7.8.2",
    "@prisma/client": "^6.19.3",
    "@tanstack/react-table": "^8.21.3",
    "@tesseract.js-data/eng": "^1.0.0",
    "jose": "^6.2.10",
    "next": "^15.3.1",
    "plaid": "^46.0.0",
    "prisma": "^6.19.3",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-plaid-link": "^5.0.0",
    "recharts": "^2.15.3",
    "tesseract.js": "^7.0.0",
    "xlsx": "^0.18.5",
    "zod": "^3.24.4"
  },
  "devDependencies": {
    "@types/node": "^22.15.3",
    "@types/react": "^19.1.2",
    "@types/react-dom": "^19.1.2",
    "typescript": "^5.8.3",
    "vitest": "^3.1.4"
  }
}
