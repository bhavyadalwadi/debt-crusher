# Never use production Clerk keys or a production database for these tests.
# Export these values in the shell that runs `npm run test:e2e:auth`.
CLERK_PUBLISHABLE_KEY="pk_test_replace-me"
CLERK_SECRET_KEY="sk_test_replace-me"
E2E_CLERK_OWNER_EMAIL="owner+clerk_test@example.com"
E2E_CLERK_NON_OWNER_EMAIL="outsider+clerk_test@example.com"

# Omit for local testing. Set to a private Vercel Preview URL for hosted validation.
E2E_BASE_URL="https://your-private-preview.example"
